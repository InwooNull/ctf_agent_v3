# CTFd 접속 정보 예시 — 실제 값으로 채워 `config/acdc.env`로 복사하세요.
#   cp config/acdc.env.example config/acdc.env
# `config/acdc.env`(및 모든 *.env)는 .gitignore 되어 있습니다. 절대 커밋하지 마세요.

# CTFd 인스턴스 base URL (예: https://ctf.example.com)
ACDC_URL=

# API 토큰 (CTFd Settings → Access Tokens). 토큰이 있으면 username/password는 생략 가능.
ACDC_TOKEN=

# 토큰 대신 로그인으로 붙을 때만 사용
ACDC_USERNAME=
ACDC_PASSWORD=
