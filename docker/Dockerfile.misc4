# ctfagent-misc:0.4 = ctfagent-misc:0.3 + a C/C++ toolchain (build-essential/g++), so a
# solver can EXECUTE source it recovers from an artifact (e.g. a git-forensics challenge
# whose program computes the flag) instead of hand-reimplementing it. Phase 47b tool-gap
# fix for the mr_de0abb (CSAW-2015 sharpturn) failure class.
#
# Network is used at BUILD time only (apt). Every run stays --network none, read-only root,
# cap-drop ALL, no-new-privileges, non-root — the compiler writes only to the rw /work bind
# mount (set TMPDIR=/work). Base ctfagent-misc:0.3 is local; do not pull it. 0.1/0.2/0.3
# remain intact as fallbacks.
FROM ctfagent-misc:0.3

USER 0:0
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

# record the toolchain in the in-image manifest
RUN { printf '%s\n' '---misc:0.4 additions---'; \
      printf 'gcc=%s\n' "$(gcc --version | head -1)"; \
      printf 'g++=%s\n' "$(g++ --version | head -1)"; \
      printf 'make=%s\n' "$(make --version | head -1)"; \
    } >> /opt/ctfagent/versions.txt; cat /opt/ctfagent/versions.txt | tail -6

# --- build-time sanity: g++ compiles AND runs a program (into a writable dir, as a run
# would use /work). Root FS is writable at build; at RUN time the compiler targets /work. -
RUN set -e; command -v gcc g++ make >/dev/null; d="$(mktemp -d)"; \
    printf '#include <cstdio>\nint main(){ long s=0; for(int i=0;i<1000;i++) s+=i; if(s==499500) puts("CPP_RUN_OK"); return 0; }\n' > "$d/p.cpp"; \
    g++ -O2 "$d/p.cpp" -o "$d/p"; \
    "$d/p" | grep -q CPP_RUN_OK; \
    echo misc-0.4-gpp-smoke-ok

USER 65534:65534
