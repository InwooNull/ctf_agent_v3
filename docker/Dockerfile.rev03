# ctfagent-rev:0.3 = ctfagent-rev:0.2 + in-sandbox decompiler lane:
#   Temurin JDK 25 + Ghidra 12.2 (headless) + Node 22 + REA (rea-agents CLI).
#
# Rationale: 0.2 ships static basics + angr (symbolic). The gap is a real
# DECOMPILER (Ghidra pseudocode) and a multi-format RE orchestrator (REA:
# APK/.NET/WASM/JS, ELF hardening triage) that angr+objdump don't cover. REA
# treats Ghidra/Hopper/IDA/Kuna as native analysis PROVIDERS, not LLM backends
# -- so `rea --provider ghidra` is pure STATIC decompilation that needs NO model
# and runs fully offline. REA is driven via its `rea` CLI from inside this image,
# NOT as a host MCP, so every untrusted binary (incl. REA's dynamic/runtime
# features) executes ONLY in-container.
#
# Build: network at BUILD time only (apt + pinned JDK/Node/Ghidra + npm). Every
# RUN of the resulting image stays --network none, read-only root FS, non-root
# 65534, cap-drop ALL (enforced by tools/sandbox.py / config/sandbox.json, both
# unchanged). Layered on proven 0.2 so 0.2 remains a working fallback.
#
# Build: docker build -f docker/Dockerfile.rev03 -t ctfagent-rev:0.3 .
FROM ctfagent-rev:0.2

USER 0:0

# --- OS deps: procps (REA needs a real `ps`), unzip/curl, build tools for any
#     native npm deps in rea-agents. ---
RUN set -eux; apt-get update; \
    apt-get install -y --no-install-recommends \
        procps unzip xz-utils curl ca-certificates make g++; \
    rm -rf /var/lib/apt/lists/*

# --- Temurin JDK 25 (Ghidra 12.2 requires JDK 25 64-bit), pinned ---
ARG JDK_URL=https://github.com/adoptium/temurin25-binaries/releases/download/jdk-25.0.5%2B8/OpenJDK25U-jdk_x64_linux_hotspot_25.0.5_8.tar.gz
ARG JDK_SHA256=68982529869257d0ee6b824ec5aa270ff8b118bb438670da0b97ebdab178d7fb
RUN set -eux; \
    curl -fsSL -o /tmp/jdk.tar.gz "${JDK_URL}"; \
    echo "${JDK_SHA256}  /tmp/jdk.tar.gz" | sha256sum -c -; \
    mkdir -p /opt/jdk; \
    tar -xzf /tmp/jdk.tar.gz -C /opt/jdk --strip-components=1; \
    rm /tmp/jdk.tar.gz
ENV JAVA_HOME=/opt/jdk
ENV PATH="/opt/jdk/bin:${PATH}"

# --- Ghidra 12.2 (NSA release, pinned) -> /opt/ghidra ---
ARG GHIDRA_URL=https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_12.2_build/ghidra_12.2_PUBLIC_20261016.zip
ARG GHIDRA_SHA256=2c2cd776db3c1f6a097ba418922378ac3649cadd5e844a6f5f088ae628a7be67
RUN set -eux; \
    curl -fsSL -o /tmp/ghidra.zip "${GHIDRA_URL}"; \
    echo "${GHIDRA_SHA256}  /tmp/ghidra.zip" | sha256sum -c -; \
    unzip -q /tmp/ghidra.zip -d /opt; \
    mv /opt/ghidra_12.2_PUBLIC /opt/ghidra; \
    rm /tmp/ghidra.zip
ENV GHIDRA_INSTALL_DIR=/opt/ghidra
ENV PATH="/opt/ghidra/support:${PATH}"

# --- Node 22 (REA engines require >=22.23.4) via nodejs.org tarball, pinned ---
ARG NODE_VERSION=22.23.4
ARG NODE_SHA256=1805bcd35e6815559bd2eb97db438d3fdb0eb3a5e6a977b7c1badca76337e9ce
RUN set -eux; \
    curl -fsSL -o /tmp/node.tar.xz \
      "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz"; \
    echo "${NODE_SHA256}  /tmp/node.tar.xz" | sha256sum -c -; \
    tar -xJf /tmp/node.tar.xz -C /opt; \
    rm /tmp/node.tar.xz
ENV PATH="/opt/node-v22.23.4-linux-x64/bin:${PATH}"

# --- REA (rea-agents) global CLI, pinned. Ghidra is the standing provider. ---
ARG REA_VERSION=6.9.0
RUN set -eux; npm install --global "rea-agents@${REA_VERSION}"
ENV REA_ANALYSIS_PROVIDER=ghidra
# Give Ghidra headroom to spin up + analyze. Measured: a tiny ELF on 1 CPU needs
# ~85s and sometimes >120s cold; real binaries take minutes. 120000 ms times out
# too early, so default high here (the experiment's own wall timeout still bounds
# the run, and a sub-agent may lower this via env for a quick target).
ENV REA_GHIDRA_STARTUP_TIMEOUT_MS=600000

# Ghidra + REA write a project/settings dir under $HOME; runtime uid 65534 has no
# home and the root FS is read-only. The rev harness mounts /work rw and the 0.2
# sitecustomize already points HOME at the first writable scratch dir (same path
# angr uses). Provide a fallback world-writable dir too.
RUN mkdir -p /opt/ctfagent/ghidra_home && chmod 0777 /opt/ctfagent/ghidra_home

# --- version record ---
RUN set -eux; \
    { echo "# ---- ctfagent-rev:0.3 = 0.2 + Ghidra 12.2 + Node 22 + REA ----"; \
      echo "jdk=$(java -version 2>&1 | head -1)"; \
      echo "ghidra=12.2_PUBLIC_20261016"; \
      echo "node=$(node --version)"; \
      echo "npm=$(npm --version)"; \
      echo "rea=$(rea --version 2>/dev/null || echo unknown)"; \
    } >> /opt/ctfagent/versions.txt

# --- build-time smoke: JDK + Node + Ghidra headless decompile + REA provider ---
RUN set -eux; \
    java -version; node --version; test -x /opt/ghidra/support/analyzeHeadless; \
    # tiny ELF (gcc from 0.1) through Ghidra headless must import+analyze: \
    printf 'int secret(int x){return x*3+7;}\nint main(){return secret(5);}\n' > /tmp/t.c; \
    gcc -o /tmp/t /tmp/t.c; \
    HOME=/opt/ctfagent/ghidra_home /opt/ghidra/support/analyzeHeadless \
      /opt/ctfagent/ghidra_home gproj -import /tmp/t -deleteProject \
      > /tmp/gh.log 2>&1 || { tail -60 /tmp/gh.log; false; }; \
    grep -qiE "Import succeeded|Analysis succeeded|REPORT:" /tmp/gh.log \
      || { echo "GHIDRA SMOKE: unexpected output"; tail -60 /tmp/gh.log; false; }; \
    echo "GHIDRA_HEADLESS_OK"; \
    # REA must enumerate providers and see ghidra (WARN-only: provider wiring is \
    # the one config detail to confirm from REA's install guide, not a build blocker): \
    HOME=/opt/ctfagent/ghidra_home rea providers --json > /tmp/prov.json 2>/tmp/prov.err \
      || { echo "REA providers failed:"; cat /tmp/prov.err; }; \
    if grep -qi ghidra /tmp/prov.json 2>/dev/null; then echo "REA_GHIDRA_PROVIDER_OK"; \
      else echo "WARN: REA did not auto-detect ghidra provider; confirm provider path config"; \
      echo "--- rea providers output ---"; cat /tmp/prov.json /tmp/prov.err 2>/dev/null || true; fi; \
    rm -f /tmp/t.c /tmp/t

# Non-root by default; the sandbox also forces --user at run time.
USER 65534:65534
