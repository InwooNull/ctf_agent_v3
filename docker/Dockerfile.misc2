# ctfagent-misc:0.2 = ctfagent-misc:0.1 + p7zip (7z/7za), for the finals misc image.
# Phase 34 surfaced that 0.1 lacks a 7z binary (a RAID/forensics challenge had to hand-decode
# LZMA2). This layers p7zip-full on the existing 0.1 image. Network is used ONLY at build time
# (apt); every run stays --network none, read-only root, non-root (unchanged from 0.1).
FROM ctfagent-misc:0.1

USER 0:0
RUN apt-get update \
    && apt-get install -y --no-install-recommends p7zip-full \
    && rm -rf /var/lib/apt/lists/* \
    && dpkg-query -W -f='${Package}=${Version}\n' p7zip-full >> /opt/ctfagent/versions.txt \
    && command -v 7z 7za >/dev/null \
    && echo misc-0.2-7z-ok

USER 65534:65534
